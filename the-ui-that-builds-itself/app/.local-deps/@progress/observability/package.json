{
  "name": "@progress/observability",
  "version": "2.1.1",
  "description": "AI agent instrumentation for TypeScript/JavaScript applications",
  "main": "dist/progress/observability/instrumentation/index.js",
  "types": "dist/progress/observability/instrumentation/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/progress/observability/instrumentation/index.d.ts",
      "import": "./dist/progress/observability/instrumentation/index.js",
      "require": "./dist/progress/observability/instrumentation/index.js",
      "default": "./dist/progress/observability/instrumentation/index.js"
    },
    "./register": {
      "types": "./dist/register/hooks.d.ts",
      "default": "./dist/register/hooks.mjs"
    },
    "./register/hooks": {
      "types": "./dist/register/hooks.d.ts",
      "default": "./dist/register/hooks.mjs"
    }
  },
  "scripts": {
    "build": "npm run clean && tsc && cpy \"src/register/**\" dist/register --flat",
    "build:watch": "tsc --watch",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts",
    "prepublish": "npm run build"
  },
  "keywords": [
    "telemetry",
    "opentelemetry",
    "ai",
    "agents",
    "tracing",
    "instrumentation",
    "typescript",
    "javascript"
  ],
  "author": "Progress Software Corporation",
  "license": "MIT",
  "files": [
    "dist/**/*",
    "README.md",
    "notices.txt",
    "LICENSE"
  ],
  "dependencies": {
    "@traceloop/node-server-sdk": "0.25.0"
  },
  "peerDependencies": {
    "@langchain/core": "^0.3.0 || ^1.0.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "import-in-the-middle": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@typescript-eslint/eslint-plugin": "8.46.4",
    "@typescript-eslint/parser": "8.46.4",
    "cpy-cli": "6.0.0",
    "eslint": "9.39.1",
    "rimraf": "6.1.0",
    "typescript": "5.8.3"
  }
}
